use std::fs;
use std::path::Path;

use crate::components::Animation;

fn main() {
    println!("cargo:rerun-if-changed=assets/");

    let assets_dir = Path::new("assets");

    let entries = fs::read_dir(assets_dir).expect("Could not read assets directory");

    for entry in entries {
        let entry = entry.expect("Invalid dir_ent");

        let path = entry.path();

        if path.extension().and_then(|s| s.to_str()) == Some("ron") {
            let content = fs::read_to_string(&path).expect("Failed to read file");

            if let Err(e) = ron::from_str::<components::Animation>(&content) {
                panic!("Failed to deserialise ron asset:{:?}\nReason:{}\n", path.display(), e);
            }
        }

    }
}
